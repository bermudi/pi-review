{
  "name": "pi-reviewer",
  "module": "dist/index.js",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "minimatch": "10.2.5",
    "typebox": "1.1.38",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "bin": {
    "pi-review": "dist/cli.js"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run clean && bun build ./src/cli.ts ./src/index.ts --outdir ./dist --target bun --packages external && tsc -p tsconfig.build.json",
    "start": "bun run src/cli.ts",
    "clean": "bun -e 'import { rm } from \"node:fs/promises\"; await rm(\"dist\", { recursive: true, force: true })'",
    "harness": "bun run test/ocr-v193/harness/index.ts --all",
    "verify:phase0-evidence": "bun run scripts/verify-phase0-evidence.ts",
    "verify:phase1-sdk": "bun run scripts/verify-phase1-sdk.ts",
    "verify:phase2-vertical": "bun run scripts/verify-phase2-vertical.ts",
    "verify:phase3-comments": "bun run scripts/verify-phase3-comments.ts",
    "verify:phase4-inputs": "bun run scripts/verify-phase4-inputs.ts",
    "verify:phase5-scan-session": "bun run scripts/verify-phase5-scan-session.ts",
    "verify:cutover": "bun run scripts/verify-cutover.ts"
  },
  "main": "dist/index.js",
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js"
  },
  "version": "0.2.0",
  "description": "Open Code Review v1.9.3 port powered by the Pi SDK",
  "license": "GPL-3.0-or-later",
  "author": "bermudi",
  "homepage": "https://github.com/bermudi/pi-reviewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bermudi/pi-reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/bermudi/pi-reviewer/issues"
  },
  "keywords": [
    "code-review",
    "git",
    "ai",
    "pi",
    "reviewer",
    "static-analysis"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES/Apache-2.0.txt"
  ]
}
